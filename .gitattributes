# app-ads.txt precisa manter quebra de linha Unix: o rastreador do AdMob le
# texto puro, e CRLF ja causou problema em outros publishers.
app-ads.txt text eol=lf
ads.txt     text eol=lf
CNAME       text eol=lf

# Arquivos lidos por robô: quebra de linha Unix, pelo mesmo motivo do ads.txt
robots.txt  text eol=lf
*.xml       text eol=lf
